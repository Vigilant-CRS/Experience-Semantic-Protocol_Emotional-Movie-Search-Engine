# MindRead V3 — Environment Configuration Template
# Copy to .env and fill in. .env is .gitignored.

# ─── LLM Provider ─────────────────────────────────────────────────────────
# One env switch selects the backend. All three pass through the same
# LLMProvider abstraction (scripts/llm_providers.py).
#
#   LLM_PROVIDER=openai     # default — covers OpenAI, Azure OpenAI, vLLM,
#                            # Ollama, Mistral La Plateforme, any OpenAI-
#                            # compatible Chat Completions endpoint
#   LLM_PROVIDER=anthropic  # Claude via Messages API
#   LLM_PROVIDER=local      # local Qwen via llama-cpp-python (in-process)
#
# Generic config (overrides provider-specific):
#   LLM_API_KEY=...         # falls back to OPENAI_API_KEY / ANTHROPIC_API_KEY
#   LLM_BASE_URL=...        # falls back to OPENAI_BASE_URL
#   LLM_MODEL=...           # falls back to OPENAI_MODEL_DNA / ANTHROPIC_MODEL

# Option A — OpenAI (or any OpenAI-compatible endpoint)
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL_DNA=gpt-5.4-mini
# OPENAI_BASE_URL=https://api.openai.com/v1   # Azure / vLLM / Ollama: point to your endpoint

# Option B — Anthropic Claude (uncomment, comment Option A)
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Option C — Local Qwen via llama-cpp (free, requires GPU sm_70+ for runtime
# speed; any GGUF model file for batch). For runtime intent on customer GPU:
LOCAL_LLM_ENABLED=0
# LLM_PROVIDER=local  # uncomment to make /api/search use local Qwen
# LOCAL_LLM_MODEL_DIR=/opt/qwen-models       # directory of GGUFs (mounted into container via LOCAL_LLM_MODEL_DIR_HOST)
# LOCAL_LLM_MODEL_DIR_HOST=/srv/models       # host path mapped to /models in container; LOCAL_LLM_MODEL_DIR should then be /models
# LOCAL_LLM_SIZE=4b                          # 2b or 4b — picks default GGUF in MODEL_DIR
# LOCAL_LLM_N_GPU_LAYERS=999                 # 999 = all layers on GPU, 0 = pure CPU
# LOCAL_LLM_CTX=8192                         # context length
# LOCAL_LLM_THREADS=12                       # CPU threads for inference

# ─── Embedding device ─────────────────────────────────────────────────────
# auto = use CUDA when GPU sm_70+ available, else CPU.
# Force values: "cuda" or "cpu".
EMBEDDING_DEVICE=auto
EMBEDDING_MODEL=intfloat/e5-large-v2

# ─── Qdrant ───────────────────────────────────────────────────────────────
# In docker-compose, defaults work. For external Qdrant, override host/port.
# QDRANT_HOST=qdrant
# QDRANT_PORT=6333
# QDRANT_COLLECTION_V3=mindread_v3

# ─── CORS ─────────────────────────────────────────────────────────────────
# Demo default is *.  In production, set explicit origins comma-separated
# (then allow_credentials becomes enabled automatically per W3C spec).
# CORS_ORIGINS=https://my-streaming-app.example.com

# ─── Optional: TMDB enrichment ────────────────────────────────────────────
# Only needed if you use the legacy `scripts/fetch_tmdb_v3.py` / `scripts/enrich_*.py`
# pipeline. The plug-and-play /api/admin/films endpoint does NOT need TMDB.
# TMDB_API_KEY=...

# ─── Tenant whitelist (optional) ──────────────────────────────────────────
# If set, /api/providers and /api/search filter to these provider names
# unless the customer explicitly overrides them per request.
# TENANT_PROVIDERS_ALLOWED=Netflix,Magenta TV+
