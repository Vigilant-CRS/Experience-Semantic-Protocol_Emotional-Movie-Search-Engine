# MindRead V3 — Environment Configuration Template
# Copy to .env and fill in. .env is .gitignored.

# ─── LLM Provider ─────────────────────────────────────────────────────────
# Option A — OpenAI (default, cheapest for free-text queries)
OPENAI_API_KEY=sk-...
OPENAI_MODEL_DNA=gpt-5-mini
# OPENAI_BASE_URL=https://api.openai.com/v1   # uncomment for OpenAI-compatible endpoint (Azure / local vLLM / etc.)

# Option B — Local Qwen via llama-cpp (free, requires GPU for runtime,
# any GGUF model for batch). Set LOCAL_LLM_ENABLED=1 to make /api/search
# use it instead of OpenAI.  Admin ingest can override per-call.
LOCAL_LLM_ENABLED=0
# LOCAL_LLM_MODEL_DIR=/opt/qwen-models       # directory of GGUFs (mounted into container via LOCAL_LLM_MODEL_DIR_HOST)
# LOCAL_LLM_MODEL_DIR_HOST=/srv/models       # host path mapped to /models in container; LOCAL_LLM_MODEL_DIR should then be /models
# LOCAL_LLM_SIZE=4b                          # 2b or 4b — picks default GGUF in MODEL_DIR
# LOCAL_LLM_N_GPU_LAYERS=999                 # 999 = all layers on GPU, 0 = pure CPU
# LOCAL_LLM_CTX=8192                         # context length
# LOCAL_LLM_THREADS=12                       # CPU threads for inference

# ─── Embedding device ─────────────────────────────────────────────────────
# auto = use CUDA when GPU sm_70+ available, else CPU.
# Force values: "cuda" or "cpu".
EMBEDDING_DEVICE=auto
EMBEDDING_MODEL=intfloat/e5-large-v2

# ─── Qdrant ───────────────────────────────────────────────────────────────
# In docker-compose, defaults work. For external Qdrant, override host/port.
# QDRANT_HOST=qdrant
# QDRANT_PORT=6333
# QDRANT_COLLECTION_V3=mindread_v3

# ─── CORS ─────────────────────────────────────────────────────────────────
# Demo default is *.  In production, set explicit origins comma-separated
# (then allow_credentials becomes enabled automatically per W3C spec).
# CORS_ORIGINS=https://my-streaming-app.example.com

# ─── Optional: TMDB enrichment ────────────────────────────────────────────
# Only needed if you use the legacy `scripts/fetch_tmdb_v3.py` / `scripts/enrich_*.py`
# pipeline. The plug-and-play /api/admin/films endpoint does NOT need TMDB.
# TMDB_API_KEY=...

# ─── Tenant whitelist (optional) ──────────────────────────────────────────
# If set, /api/providers and /api/search filter to these provider names
# unless the customer explicitly overrides them per request.
# TENANT_PROVIDERS_ALLOWED=Netflix,Magenta TV+
